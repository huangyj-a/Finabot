LLM_PROVIDER=
LLM_MODEL=
# 可选：OpenAI 兼容自定义端点（例如 https://inferaichat.com/v1）
LLM_API_BASE=
# 可选：通用 API Key 覆盖；未设置时按 {PROVIDER}_API_KEY 读取（如 OPENAI_API_KEY / ZAI_API_KEY），最后回退 ZHIPU_API_KEY
LLM_API_KEY=
# CLI 响应等待超时（秒），复杂分析（单股持有流水线含 6 次 LLM 调用）建议设 420 以上
FINABOT_RESPONSE_TIMEOUT_SECONDS=420
# 单次 LLM 调用超时（秒）
FINABOT_LLM_TIMEOUT_SECONDS=120
# 跨轮次滚动对话摘要：长对话中段定期用 LLM 汇总并持久化，下一轮注入提示词
# FINABOT_ROLLING_SUMMARY=on                 # off 完全关闭；默认 on
# FINABOT_ROLLING_SUMMARY_MIN_MESSAGES=12    # 少于该条数不生成摘要
# FINABOT_ROLLING_SUMMARY_WINDOW=8           # 中段新增达该条数才更新一次
# FINABOT_ROLLING_SUMMARY_TAIL_KEEP=6        # 尾部留在上下文窗口、不进摘要
# FINABOT_ROLLING_SUMMARY_MAX_CHARS=350      # 摘要最大长度（字）
# FINABOT_ROLLING_SUMMARY_MAX_MSG_CHARS=400  # 摘要输入中单条消息截断长度（字符）
